# --- ICE / STUN / TURN ---
# Development: STUN only
STUN_URLS=stun:stun.l.google.com:19302
# Production (cellular devices): TURN is required or calls drop within ~1 min
# when the CGNAT UDP mapping expires. Deploy coturn first:
#   VPS:    sudo bash turn/setup_vps.sh
#   Local:  docker compose -f turn/docker-compose.yml up -d
# Verify:  .venv/Scripts/python.exe scripts/check_turn.py
# Never commit real credentials.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- App ---
LOG_LEVEL=INFO
# ICE_DEBUG=true: trace every STUN message in/out (aioice) plus ICE/DTLS
# events (aiortc) to find why peer keepalives go unanswered before a drop.
ICE_DEBUG=false
# LOG_FILE=path: also append all logs to a file (full untruncated trace
# for post-mortem, e.g. LOG_FILE=ice_debug.log)
LOG_FILE=
# ICE_CONSENT_FAILURES: consecutive unanswered consent checks (5 s apart)
# before the server force-closes the call. Default 60 (~5 min).
# The embedded client never answers consent after SRTP starts - stock aioice
# (6) killed every call at ~30 s ("Consent to send expired").
# 0 = never force-close, 6 = stock aioice.
# ICE_CONSENT_FAILURES=60
# Echo mode: received audio is sent straight back. If no audio frames arrive
# for this long, the echoed reply is closed with the 00 FF end marker
# (the Soundbox stops sending RTP after its 1 s silence tail).
# A device end-of-speech packet (RTP payload 00 FE) closes it immediately.
VAD_NO_AUDIO_MS=400
# Echo jitter buffer: audio held before echo playback starts (and after an
# underrun). Higher = smoother on bad networks, but more delay.
ECHO_PREBUFFER_MS=200
# SNTP server for the startup host-clock check (blank = skip)
NTP_CHECK_SERVER=pool.ntp.org
