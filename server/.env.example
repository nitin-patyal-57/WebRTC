# --- Groq (STT + LLM + TTS) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
# groq = Orpheus (requires org terms acceptance); sapi = local Windows dev fallback
TTS_PROVIDER=groq
STT_LANGUAGE=en

# --- ICE / STUN / TURN ---
# Development: STUN only
STUN_URLS=stun:stun.l.google.com:19302
# Production (cellular devices): add TURN. Never commit real credentials.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- App ---
LOG_LEVEL=INFO
MAX_HISTORY_MESSAGES=10
VAD_SILENCE_MS=700
VAD_MIN_SPEECH_MS=300
VAD_THRESHOLD=0.025
# If no audio frames arrive for this long mid-speech, force the VAD endpoint
VAD_STALL_MS=3000
# BARGE_IN=false: never cancel an in-flight reply; new speech becomes next turn
BARGE_IN=false
# STT_PARTIALS=false: buffer until speech ends, single transcription call
STT_PARTIALS=false

# --- Knowledge base (curated Soundbox Q&A) ---
# KB_ENABLED=true: answer questions similar to the training data with the canned response
KB_ENABLED=true
# Minimum similarity (0-1) required to serve a canned answer instead of the LLM
KB_MATCH_THRESHOLD=0.55

# --- Fixed answers (data/fixed_answers.json) ---
# FIXED_ANSWERS_ENABLED=true: exact-match questions (greetings etc.) are answered
# instantly without KB scoring or an LLM call; real-time questions still use the LLM
FIXED_ANSWERS_ENABLED=true

# --- Answer cache (learns Q->A after first answer, data/answer_cache.json) ---
# ANSWER_CACHE_ENABLED=true: a question answered once is answered instantly next time
# (no KB/LLM). Real-time questions (weather, last transaction, summary) are never cached.
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_MAX=500
