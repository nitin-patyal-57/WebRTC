server/certs/key.pem
server/certs/*.pem

# Android / Gradle
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.iml
captures/

# Misc
.DS_Store
Thumbs.db
.vscode/
.idea/
